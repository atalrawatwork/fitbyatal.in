# Site
NEXT_PUBLIC_SITE_URL=https://fitbyatal.in

# Google AdSense (replace with your real publisher id)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Newsletter (Mailchimp / ConvertKit form action URL)
NEXT_PUBLIC_NEWSLETTER_ACTION=

# OneSignal (web push)
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Google Search Console "HTML tag" verification token (just the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form endpoint (Formspree / Web3Forms / Getform URL). If empty, the form falls back to mailto:
NEXT_PUBLIC_CONTACT_ACTION=
